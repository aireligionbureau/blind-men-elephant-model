DEEPSEEK_API_KEY=replace-with-your-key

# Any OpenAI-compatible chat endpoint can replace DeepSeek without changing the pipeline.
# Generic BME_* values take precedence over the DeepSeek-specific fallbacks above.
BME_LLM_API_KEY=
# Optional provider label for pricing attribution; the endpoint/model below select the actual API.
BME_LLM_PROVIDER_PRESET=
BME_LLM_BASE_URL=
BME_LLM_MODEL=
BME_COHORT_MODEL=
BME_LLM_SUPPORTS_THINKING=
BME_INPUT_PRICE_PER_1M_CNY=
BME_OUTPUT_PRICE_PER_1M_CNY=

# Legacy DeepSeek-specific pricing names remain accepted as fallbacks.
DEEPSEEK_INPUT_PRICE_PER_1M_CNY=
DEEPSEEK_OUTPUT_PRICE_PER_1M_CNY=

# Google Programmable Search / Custom Search JSON API
GOOGLE_API_KEY=replace-with-google-key
GOOGLE_CSE_ID=replace-with-search-engine-id
GOOGLE_SEARCH_LANGUAGE=lang_en
GOOGLE_SEARCH_COUNTRY=us
GOOGLE_SEARCH_SAFE=off

# Baidu-compatible JSON SERP endpoint (preferred; baidu-html needs no key but is less stable)
BAIDU_SEARCH_ENDPOINT=https://example.com/search
BAIDU_SEARCH_API_KEY=replace-with-baidu-or-serp-key
BAIDU_SEARCH_QUERY_PARAM=q
BAIDU_SEARCH_LIMIT_PARAM=limit
BAIDU_SEARCH_API_KEY_PARAM=
BAIDU_SEARCH_AUTH_HEADER=Authorization
BAIDU_SEARCH_AUTH_PREFIX=Bearer
BAIDU_SEARCH_RESULTS_PATH=
BAIDU_SEARCH_TITLE_FIELD=title,name
BAIDU_SEARCH_URL_FIELD=url,link
BAIDU_SEARCH_SNIPPET_FIELD=snippet,summary,description

# Search routing: cn -> Baidu, global -> Google when configured
BME_SEARCH_REGION=global
BME_SEARCH_ALLOW_MOCK_FALLBACK=0
