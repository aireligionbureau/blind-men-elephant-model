{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blind-men-elephant/capture_protocol.schema.json",
  "title": "CaptureProtocolStage",
  "type": "object",
  "required": [
    "stage",
    "touch_target",
    "what_to_inspect",
    "shadow_questions",
    "evidence_needed",
    "failure_if_skipped"
  ],
  "properties": {
    "stage": { "type": "string" },
    "touch_target": { "type": "string" },
    "what_to_inspect": { "type": "array", "items": { "type": "string" } },
    "shadow_questions": { "type": "array", "items": { "type": "string" } },
    "evidence_needed": { "type": "array", "items": { "type": "string" } },
    "failure_if_skipped": { "type": "string" }
  }
}
