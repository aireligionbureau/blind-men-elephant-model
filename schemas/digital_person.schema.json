{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blind-men-elephant/digital_person.schema.json",
  "title": "DigitalPerson",
  "type": "object",
  "required": [
    "id",
    "name",
    "cognitive_frames",
    "expertise",
    "values",
    "time_horizon",
    "risk_attitude",
    "analysis_levels",
    "hidden_biases",
    "information_filter",
    "temperament"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "role_summary": { "type": "string" },
    "cognitive_frames": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expertise": {
      "type": "object",
      "required": ["strong", "weak"],
      "properties": {
        "strong": { "type": "array", "items": { "type": "string" } },
        "weak": { "type": "array", "items": { "type": "string" } }
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "time_horizon": { "type": "string" },
    "risk_attitude": { "type": "string" },
    "analysis_levels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hidden_biases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "information_filter": {
      "type": "object",
      "required": ["trusted_sources", "distrusted_sources", "preferred_evidence", "ignored_evidence"],
      "properties": {
        "trusted_sources": { "type": "array", "items": { "type": "string" } },
        "distrusted_sources": { "type": "array", "items": { "type": "string" } },
        "preferred_evidence": { "type": "array", "items": { "type": "string" } },
        "ignored_evidence": { "type": "array", "items": { "type": "string" } },
        "query_style": { "type": "array", "items": { "type": "string" } }
      }
    },
    "temperament": { "type": "string" }
  }
}
