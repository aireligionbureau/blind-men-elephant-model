{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blind-men-elephant/evidence_ledger.schema.json",
  "title": "EvidenceLedger",
  "type": "object",
  "required": ["person_id", "question", "search_strategy", "source_decisions", "entries"],
  "properties": {
    "person_id": { "type": "string" },
    "question": { "type": "string" },
    "search_strategy": {
      "type": "object",
      "description": "The filtered search plan generated from the digital person's information intake identity."
    },
    "source_decisions": {
      "type": "array",
      "description": "All candidate sources with accept/reject/ignore decisions.",
      "items": {
        "type": "object",
        "required": ["decision", "trust_score", "reasons", "result"],
        "properties": {
          "decision": { "type": "string", "enum": ["accept", "reject", "ignore"] },
          "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "shadow_hint": { "type": ["string", "null"] },
          "result": { "type": "object" }
        }
      }
    },
    "accepted_sources": { "type": "array", "items": { "type": "object" } },
    "rejected_sources": { "type": "array", "items": { "type": "object" } },
    "ignored_sources": { "type": "array", "items": { "type": "object" } },
    "information_shadow_hints": { "type": "array", "items": { "type": "string" } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "source_id", "query", "claim", "source", "source_name", "source_type", "evidence_type", "verification_status", "evidence_use_role", "trust_reason", "used_for", "confidence"],
        "properties": {
          "entry_id": { "type": "string" },
          "source_id": { "type": "string" },
          "query": { "type": "string" },
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "source_name": { "type": "string" },
          "source_title": { "type": "string" },
          "source_type": { "type": "string" },
          "evidence_type": { "type": "string" },
          "verification_status": { "type": "string" },
          "evidence_use_role": {
            "type": "string",
            "enum": ["shadow_only", "candidate_observation", "directional_eligible"]
          },
          "trust_reason": { "type": "string" },
          "used_for": { "type": "string" },
          "ignored_counterevidence": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
