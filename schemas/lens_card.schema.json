{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blind-men-elephant/lens_card.schema.json",
  "title": "LensCard",
  "type": "object",
  "required": [
    "id",
    "name",
    "source_works",
    "category",
    "core_idea",
    "detect_signals",
    "diagnostic_questions",
    "shadow_types",
    "source_stages",
    "mechanism_chain",
    "attribution_rules",
    "inversion_rules",
    "boundary_conditions",
    "anti_misuse_rules",
    "model_training_notes",
    "self_reflection"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "source_works": { "type": "array", "items": { "type": "string" } },
    "category": { "type": "string" },
    "core_idea": { "type": "string" },
    "detect_signals": { "type": "array", "items": { "type": "string" } },
    "diagnostic_questions": { "type": "array", "items": { "type": "string" } },
    "shadow_types": { "type": "array", "items": { "type": "string" } },
    "source_stages": { "type": "array", "items": { "type": "string" } },
    "mechanism_chain": { "type": "array", "items": { "type": "string" } },
    "observable_markers": { "type": "array", "items": { "type": "string" } },
    "attribution_rules": { "type": "array", "items": { "type": "string" } },
    "inversion_rules": { "type": "array", "items": { "type": "string" } },
    "puzzle_uses": { "type": "array", "items": { "type": "string" } },
    "boundary_conditions": { "type": "array", "items": { "type": "string" } },
    "anti_misuse_rules": { "type": "array", "items": { "type": "string" } },
    "model_training_notes": { "type": "array", "items": { "type": "string" } },
    "self_reflection": { "type": "array", "items": { "type": "string" } }
  }
}
