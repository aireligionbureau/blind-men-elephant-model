{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/blind-men-elephant/relation_certificate.schema.json",
  "title": "RelationCertificate",
  "type": "object",
  "required": [
    "relation_id",
    "relation_type",
    "piece_ids",
    "status",
    "plain_language_explanation",
    "competing_explanation",
    "falsification_test",
    "independence_profile",
    "knowledge_provenance"
  ],
  "properties": {
    "relation_id": { "type": "string", "minLength": 1 },
    "relation_type": { "type": "string", "minLength": 1 },
    "piece_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "rejected", "unresolved", "proposed"]
    },
    "plain_language_explanation": { "type": "string" },
    "competing_explanation": { "type": "string" },
    "falsification_test": { "type": "string" },
    "independence_profile": {
      "type": "object",
      "properties": {
        "model_independence": { "type": "string" },
        "evidence_origin_independence": { "type": "string" },
        "publisher_independence": { "type": "string" },
        "directional_support_authorized": { "type": "boolean" }
      }
    },
    "knowledge_provenance": {
      "type": "object",
      "required": ["epistemic_role", "classic_as_world_evidence"],
      "properties": {
        "epistemic_role": { "const": "diagnostic_method_not_world_evidence" },
        "classic_as_world_evidence": { "const": false }
      }
    }
  }
}
